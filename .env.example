# ── AI Provider ──────────────────────────────────────────────
# "mock"      : Claude 없이 동작하는 휴리스틱 분석 (기본값, 개발/데모용)
# "claude"    : 서버에 설치된 Claude CLI 실행
# "anthropic" : Anthropic API 직접 호출 (배포 환경 권장, ANTHROPIC_API_KEY 필요)
AI_PROVIDER=mock

# AI_PROVIDER=anthropic 일 때
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Claude CLI 실행 명령 (PATH에 있는 실행 파일명 또는 절대 경로)
CLAUDE_COMMAND=claude
# Claude CLI 추가 인자 (공백 구분). 프롬프트는 항상 stdin으로 전달됨
CLAUDE_ARGS=-p
# AI 실행 타임아웃 (ms)
CLAUDE_TIMEOUT=180000

# AI 분석에 사용할 문서당 최대 텍스트 길이 (문자)
AI_MAX_DOC_CHARS=24000
# 업로드 허용 최대 파일 크기 (bytes, 기본 20MB)
MAX_FILE_SIZE=20971520

# ── Database / Storage ───────────────────────────────────────
# SQLite 데이터베이스 파일 경로 (기본: ./data/zunall.db)
DATABASE_PATH=./data/zunall.db
# 업로드 파일 저장 경로 (기본: ./data/uploads)
UPLOAD_DIR=./data/uploads

# ── Auth ─────────────────────────────────────────────────────
# 세션 유지 기간 (일)
SESSION_DAYS=30
