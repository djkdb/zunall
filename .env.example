# ── Database (PostgreSQL / Supabase) ─────────────────────────
# 비워두면 로컬 PGlite(설치 불필요한 내장 Postgres)로 자동 폴백됩니다.
# Supabase: 대시보드 → Connect → "Transaction pooler" 문자열 (포트 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 스키마를 앱 부팅 시 자동 생성 (로컬/테스트용). 운영에서는 schema.sql 을 1회 적용하세요.
# DB_AUTO_MIGRATE=1

# ── Storage (Supabase Storage) ───────────────────────────────
# 아래 둘이 있으면 Supabase Storage, 없으면 로컬 data/uploads 사용
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zunall-uploads

# ── AI Provider ──────────────────────────────────────────────
# "mock"      : Claude 없이 동작하는 휴리스틱 분석 (기본값, 개발/데모용)
# "claude"    : 서버에 설치된 Claude CLI 실행 (Workers 불가)
# "anthropic" : Anthropic API 직접 호출 (배포 환경 권장)
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Claude CLI provider 설정
CLAUDE_COMMAND=claude
CLAUDE_ARGS=-p
CLAUDE_TIMEOUT=180000

# ── 기타 ─────────────────────────────────────────────────────
AI_MAX_DOC_CHARS=24000
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./data/uploads
PGLITE_PATH=./data/pg
SESSION_DAYS=30
