# ── Database (PostgreSQL) ────────────────────────────────────
# 배포에 필요한 유일한 필수값. 비워두면 로컬 PGlite(내장 Postgres)로 자동 폴백됩니다.
# Neon(무료·카드 불필요): https://neon.tech → Connection string 복사
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 드라이버 강제 지정 (기본: Workers+neon.tech면 neon-http, 그 외 postgres-js)
# DB_DRIVER=neon-http

# 스키마를 앱 부팅 시 자동 생성 (로컬/테스트용). 운영에서는 schema.sql 을 1회 적용하세요.
# DB_AUTO_MIGRATE=1

# ── 파일 저장 ────────────────────────────────────────────────
# 기본은 DB 저장(document_blobs)이라 아무 설정도 필요 없습니다.
# db | r2 | supabase | local 중 강제 지정할 때만 사용
# STORAGE_BACKEND=db

# R2 를 쓰려면 wrangler.jsonc 의 r2_buckets 주석 해제 (바인딩 이름 BUCKET)
# Supabase Storage 를 쓰려면 아래 둘을 설정
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=zunall-uploads

# ── AI Provider ──────────────────────────────────────────────
# "mock"      : Claude 없이 동작하는 휴리스틱 분석 (기본값, 개발/데모용)
# "claude"    : 서버에 설치된 Claude CLI 실행 (Workers 불가)
# "anthropic" : Anthropic API 직접 호출 (배포 환경 권장)
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Claude CLI provider 설정
CLAUDE_COMMAND=claude
CLAUDE_ARGS=-p
CLAUDE_TIMEOUT=180000

# ── 기타 ─────────────────────────────────────────────────────
AI_MAX_DOC_CHARS=24000
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./data/uploads
PGLITE_PATH=./data/pg
SESSION_DAYS=30
