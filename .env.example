# ── Database (PostgreSQL) ────────────────────────────────────
# 배포에 필요한 유일한 필수값. 비워두면 로컬 PGlite(내장 Postgres)로 자동 폴백됩니다.
# Neon(무료·카드 불필요): https://neon.tech → Connection string 복사
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 드라이버 강제 지정 (기본: Workers+neon.tech면 neon-http, 그 외 postgres-js)
# DB_DRIVER=neon-http

# 로컬 테스트에서 가짜 Neon 엔드포인트로 돌릴 때만 사용 (운영에서는 설정하지 않음)
# NEON_FETCH_ENDPOINT=

# 스키마를 앱 부팅 시 자동 생성 (로컬/테스트용). 운영에서는 schema.sql 을 1회 적용하세요.
# DB_AUTO_MIGRATE=1

# ── 파일 저장 ────────────────────────────────────────────────
# 기본은 DB 저장(document_blobs)이라 아무 설정도 필요 없습니다.
# db | r2 | supabase | local 중 강제 지정할 때만 사용
# STORAGE_BACKEND=db

# R2 를 쓰려면 wrangler.jsonc 의 r2_buckets 주석 해제 (바인딩 이름 BUCKET)
# Supabase Storage 를 쓰려면 아래 둘을 설정
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=zunall-uploads

# ── 구글 로그인 (선택) ─────────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 →
# OAuth 클라이언트 ID(웹 애플리케이션) 생성 후 아래 두 값을 채우면 버튼이 나타납니다.
# 승인된 리디렉션 URI: https://<배포주소>/api/auth/google/callback
#                      http://localhost:3000/api/auth/google/callback (로컬용)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 리디렉션 URI 를 직접 고정하고 싶을 때만 사용
# GOOGLE_REDIRECT_URI=

# ── 브라우저 푸시 알림 (선택) ─────────────────────────────
# 키 생성: npx tsx scripts/gen-vapid.ts  (또는 npm run vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# 매일 알림을 보내는 크론 엔드포인트 보호키 (없으면 크론이 동작하지 않음)
# CRON_KEY=
# Cloudflare Cron 이 자기 자신을 호출할 때 쓰는 주소
# APP_URL=https://cavero.example.workers.dev

# ── AI Provider ──────────────────────────────────────────────
# "mock"      : Claude 없이 동작하는 휴리스틱 분석 (기본값, 개발/데모용)
# "claude"    : 서버에 설치된 Claude CLI 실행 (Workers 불가)
# "anthropic" : Anthropic API 직접 호출 (배포 환경 권장)
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Claude CLI provider 설정
CLAUDE_COMMAND=claude
CLAUDE_ARGS=-p
CLAUDE_TIMEOUT=180000

# ── 기타 ─────────────────────────────────────────────────────
AI_MAX_DOC_CHARS=24000
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./data/uploads
PGLITE_PATH=./data/pg
SESSION_DAYS=30
