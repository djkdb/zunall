// Cloudflare Workers 배포 설정 (OpenNext + Supabase)
// DB/스토리지/AI 키는 모두 secret 으로 주입한다 — 이 파일에 값을 적지 말 것.
//
// 배포 전 준비 (자세한 절차는 DEPLOY.md):
//   npx wrangler login
//   npx wrangler secret put DATABASE_URL              (Supabase 트랜잭션 풀러 URL)
//   npx wrangler secret put SUPABASE_URL
//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
//   npx wrangler secret put ANTHROPIC_API_KEY
//   npm run deploy:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zunall",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AI_PROVIDER": "anthropic",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "SUPABASE_STORAGE_BUCKET": "zunall-uploads"
  }
}
